generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile               Profile?
  roadmaps              Roadmap[]
  progressLogs          ProgressLog[]
  externalIntegrations  ExternalIntegration[]
  agentLogs             AgentLog[]
}

model Profile {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                String   @unique @db.ObjectId
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  college               String?
  branch                String?
  year                  Int?
  cgpa                  Float?
  skills                String[]
  targetCompanies       String[]
  targetRoles           String[]
  availableHoursPerWeek Int      @default(10)
  resumeUrl             String?
  
  githubUsername        String?
  leetcodeUsername      String?
  codeforcesUsername    String?
  leetcodeSolved        Int      @default(0)
  minPackageLPA         Float?
  
  updatedAt             DateTime @updatedAt
}

model Roadmap {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  durationWeeks  Int           @default(16)
  globalNotes    String[]
  generatedAt    DateTime      @default(now())
  isActive       Boolean       @default(true)
  
  weeks          RoadmapWeek[]
}

model RoadmapWeek {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  roadmapId        String        @db.ObjectId
  roadmap          Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  weekNumber       Int
  focusAreas       String[]
  targets          String[]
  expectedOutcomes String[]
  reasoning        String?
  priorityScore    Float?
  estimatedHours   Int?
  phase            String?
  
  tasks            RoadmapTask[]
}

model RoadmapTask {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  weekId         String       @db.ObjectId
  week           RoadmapWeek  @relation(fields: [weekId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  estimatedHours Int?
  isCompleted    Boolean      @default(false)
  completedAt    DateTime?
}

model ProgressLog {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  weekNumber        Int
  taskId            String?
  completionPercent Float
  hoursSpent        Float?
  notes             String?
  timestamp         DateTime @default(now())
}

model SkillAnalytics {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  date         DateTime @default(now())
  
  skillName    String
  currentLevel Float
  targetLevel  Float
  problemsSolved Int?
  source       String
}

model CompanyMatch {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  
  companyName        String
  fitScore           Float
  successProbability Float
  packageMin         Float?
  packageMax         Float?
  requiredSkills     String[]
  matchedSkills      String[]
  skillGaps          String[]
  minCGPA            Float?
  hiringStatus       String?
  computedAt         DateTime @default(now())
}

model OptimizationInsight {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  
  type            String
  title           String
  priority        Float
  estimatedImpact Float?
  data            Json
  generatedAt     DateTime @default(now())
}

model ExternalIntegration {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userId         String             @db.ObjectId
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider       String
  username       String
  encryptedToken String?
  isConnected    Boolean            @default(false)
  lastSyncAt     DateTime?
  syncStatus     String?
  syncError      String?
  createdAt      DateTime           @default(now())
  
  metrics        ExternalMetric[]
  
  @@unique([userId, provider])
}

model ExternalMetric {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  integrationId  String              @db.ObjectId
  integration    ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  date           DateTime
  stats          Json
}

model AgentLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  agentType    String
  inputPrompt  String
  inputData    Json
  outputData   Json
  tokensUsed   Int?
  latencyMs    Int?
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())
}
